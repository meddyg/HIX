@startuml hix-actores-paciente
!pragma layout smetana
hide stereotype
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam nodesep 12
skinparam ranksep 18
skinparam rectangle {
  BorderColor #555555
  RoundCorner 12
  FontStyle bold
}
skinparam rectangle<<inner>> {
  BackgroundColor white
  BorderColor #444444
  BorderStyle dashed
  RoundCorner 0
  FontStyle plain
  FontSize 10
}
skinparam arrow {
  Color #333333
  FontSize 9
}
left to right direction
rectangle "Aplicación del paciente" as APP #DAE8FC {
  rectangle "IUA Authorization Client" <<inner>> as APP1
  rectangle "MHD Document Consumer" <<inner>> as APP2
}
rectangle "Authorization Server (STS)" as STS #F5F5F5 {
  rectangle "IUA Authorization Server" <<inner>> as STS1
  rectangle "OpenID Provider" <<inner>> as STS2
  rectangle "PIXm Consumer" <<inner>> as STS3
}
rectangle "Record Locator Service (Mediador)" as RLS #D5E8D4 {
  rectangle "IUA Resource Server" <<inner>> as RLS1
  rectangle "IUA Authorization Client" <<inner>> as RLS0
  rectangle "MHD Document Responder" <<inner>> as RLS2
  rectangle "MHD Document Consumer (delegated)" <<inner>> as RLS3
  rectangle "PIXm / PDQm Consumer (delegated)" <<inner>> as RLS4
}
rectangle "Custodio" as CUST #FFE6CC {
  rectangle "IUA Resource Server" <<inner>> as CUST1
  rectangle "MHD Document Responder" <<inner>> as CUST2
}
APP1 --> STS1 : [HIX-2] Patient Application Launch\npurpose_of_use = PATRQT, FAMRQT o PWATRNY\npaciente = identidad maestra
APP2 --> RLS2 : [ITI-67] Find Document References\n[ITI-68] Retrieve Document\ntoken aud = RLS, confinado al paciente
STS1 <-- RLS0 : [HIX-1] Custodian Token Exchange
RLS3 --> CUST2 : [ITI-68] Retrieve Document\ntoken derivado, aud = custodio
@enduml
