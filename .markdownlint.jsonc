// Style of the specification's pages. `make format` fixes what can be fixed.
{
    // Each page starts below the title the site renders from sushi-config.yaml.
    "MD041": false,
    // Prose is one paragraph per line; line length means nothing there.
    "MD013": false,
    // kramdown attaches `{: .table ...}` to the table above it; a GFM parser
    // reads that line as one more (malformed) row.
    "MD055": false,
    "MD056": false,
    // IHE use cases repeat "Descripción del caso de uso" / "Flujo del proceso"
    // under each case; only siblings must be unique.
    "MD024": { "siblings_only": true },
    // Bootstrap tabs (the template ships the plugin) are the only raw HTML.
    "MD033": { "allowed_elements": ["ul", "li", "a", "div"] }
}
